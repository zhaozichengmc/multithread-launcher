<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PCLDownloader</AssemblyName>
    <RootNamespace>PclDlGui</RootNamespace>
    <Version>2.4.0</Version>
    <Product>光速下载器</Product>
    <AssemblyTitle>光速下载器</AssemblyTitle>
    <Description>基于动态分块的多线程下载工具，内置网页浏览器与在线更新</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebView2Loader.dll" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.8.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)runtimes/win-x64/native/WebView2Loader.dll" DestinationFolder="$(OutputPath)" Condition="Exists('$(OutputPath)runtimes/win-x64/native/WebView2Loader.dll')" />
  </Target>

</Project>
